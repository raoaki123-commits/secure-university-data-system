# ==============================================================================
# SECURE RESOURCE RECOMMENDATION SYSTEM FOR UNIVERSITY COMMUNITIES
# OFFICIAL TEAM CODE: 2602233
# Unified Environment Variable Specification (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Flask Backend Server Configuration
# ------------------------------------------------------------------------------
FLASK_ENV=production
FLASK_APP=wsgi.py
PORT=5000
HOST=0.0.0.0

# Cryptographically Secure Master Application Secret (Generate via: openssl rand -hex 32)
SECRET_KEY=replace-with-secure-32-byte-hexadecimal-secret-key

# JWT Token Signing Secret (HS256)
JWT_SECRET_KEY=replace-with-secure-jwt-signing-key-minimum-32-bytes
JWT_ACCESS_EXP_MINUTES=15
JWT_REFRESH_EXP_DAYS=7

# RBAC Tier 4 Administrator Provisioning Key
# Required in header 'X-Admin-Provision-Key' when provisioning initial administrator
ADMIN_PROVISION_KEY=replace-with-high-entropy-admin-provisioning-token

# ------------------------------------------------------------------------------
# 2. MongoDB Database Configuration
# ------------------------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/university_recommender
MONGO_DB_NAME=university_recommender
USE_MOCK_DB=false

# ------------------------------------------------------------------------------
# 3. Security, CORS, and Rate Limiting
# ------------------------------------------------------------------------------
# Comma-separated list of permitted origin origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,https://recommender.university.edu

# Sliding window rate limiting on authentication routes (attempts per minute per IP)
MAX_LOGIN_ATTEMPTS_PER_MINUTE=10

# ------------------------------------------------------------------------------
# 4. Cryptographic Keystore Configuration (TenSEAL CKKS)
# ------------------------------------------------------------------------------
KEYSTORE_PATH=app/keystore/ckks_keys.bin
CKKS_POLY_MODULUS_DEGREE=8192
CKKS_SCALE_BITS=40

# ------------------------------------------------------------------------------
# 5. Frontend Client Configuration (Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1
VITE_APP_TITLE="Secure University Recommender"
VITE_ENABLE_ANALYTICS=false

