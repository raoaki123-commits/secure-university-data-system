# =================================================================
# Secure Resource Recommendation System for University Communities
# Environment Configuration Template (.env.example)
# Team Code: 2602233 | Project Code: SHTKS (26O2227)
# =================================================================

# Flask Environment Configuration
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=sovereign-university-dev-secret-key-32b-min

# Cryptographic Token Parameters (HS256)
JWT_SECRET_KEY=jwt-cryptographic-signing-key-university-2026
JWT_ACCESS_EXP_MINUTES=15
JWT_REFRESH_EXP_DAYS=7

# MongoDB Sovereign Enclave URI
MONGO_URI=mongodb://localhost:27017/university_recommender
MONGO_DB_NAME=university_recommender
USE_MOCK_DB=false

# RBAC Level 4 Administrator Provisioning Key
# Used to authenticate bootstrapping of admin accounts via X-Admin-Provision-Key header
ADMIN_PROVISION_KEY=sovereign-admin-provision-token-26O2227

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173

# Rate Limiting Parameters (Sliding Window in Seconds)
MAX_LOGIN_ATTEMPTS_PER_MINUTE=10

